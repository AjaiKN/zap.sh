#!/usr/bin/env bash

set -euo pipefail
# shellcheck disable=SC2154
trap 's=$?; echo >&2 "$0: Error on line "$LINENO": $BASH_COMMAND"; exit $s' ERR

# Also see (cross-platform):
# - the Emacs `move-file-to-trash` command
# - https://github.com/sindresorhus/trash

# ensure no leading - (so nothing thinks it's a flag)
mkpath() {
	case "$1" in
		(/*) printf '%s' "$1" ;;
		(*) printf './%s' "$1" ;;
	esac
}
mydirname() {
	dirname "$(mkpath "$1")"
}
mybasename() {
	# In GNU bash 3.2.57(1)-release, `basename -- ...` doesn't work
	basename "$(mkpath "$1")"
}

# https://stackoverflow.com/a/21188136
# Mostly like `realpath --no-symlinks`, but --no-symlinks is only available for GNU realpath.
get_abs_filename() {
	local dirname basename
	dirname=$(mydirname "$1") || exit 2
	if [ -d "$dirname" ]; then
		basename=$(mybasename "$1") || exit 2
		printf "%s" "$(cd "$dirname" >/dev/null && pwd)/${basename}"
	else
		echo "Directory does not exist: $dirname" >&2
		return 1
	fi
}

print_usage() {
	# NOTE: When this changes, rerun $DOTFILES/scripts/generate-manpages.sh
	cat <<EOF
Usage: ${0##*/} [OPTION]... [--] FILE...
  or:  ${0##*/} --list
  or:  ${0##*/} --restore [OPTION]... [--] FILE...
Put each FILE in the trash. Currently supports macOS and Linux.

  -h, --help               Show this usage message.
  -f, --force              Override non-writable files, ignore nonexistent files, and skip untrashable ones.
                           Like rm -f: files that don't have write permissions are trashed anyway, nonexistent
                           files are silently ignored, and files that can't be trashed (e.g. because their
                           directories aren't writable) are reported and skipped while everything else is
                           still trashed, in which case the exit status is 1. Without --force, this command
                           refuses to do anything if any of the arguments would fail to be trashed.
  -n, --dry-run            Don't actually trash anything; just print what this command *would* do.
                           This option implies --verbose.
  -v, --verbose            Be more verbose.
  -s, --strategy=STRATEGY  Specify which trashing strategy to use.
                           Can also be specified with the ZAP_STRATEGY environment variable, which this
                           option supersedes.
  -l, --list               List trashed files (oldest first) as DELETIONDATE<TAB>ORIGINALPATH.
      --restore            Restore each FILE (given by its original path) from the trash. If a path was
                           trashed more than once, restore the most recent one. Refuses to overwrite.
                           --list and --restore work regardless of strategy. They see freedesktop.org
                           trash directories, plus items zap trashed with the macOS strategies (recorded
                           in \$XDG_DATA_HOME/zap/info). Items trashed with other tools on macOS aren't
                           seen.
  -d, --dir                Does nothing. For compatibility with rm.
  -r, -R, --recursive      Does nothing. For compatibility with rm.

*Available strategies*
  freedesktop              (default on Linux) Use the freedesktop.org Trash Specification:
                           https://specifications.freedesktop.org/trash-spec/1.0/
  macos_trash_command      (default on macOS >=14.0) Use the built-in macOS /usr/bin/trash command
  macos_applescript        (default on macOS <14.0) Use AppleScript
  macos_mv                 Use mv to move to ~/.Trash/
  gio                      Use the 'gio trash' command
  kioclient                Use the 'kioclient move FILE... trash:/' command
  trash_cli                Use trash-put from trash-cli: https://github.com/andreafrancia/trash-cli
  dangerous_rm             Use rm
  dangerous_shred          Use GNU shred
EOF
	# SEE ALSO:
	#   rm(1), mv(1), find(1), unlink(1)
}

urlencode_help() {
	# https://askubuntu.com/a/712206
	local LC_ALL=C c n
	while IFS= read -r -n1 -d '' c
	do
		if [[ $c = [a-zA-Z0-9/.~_-] ]]
		then
			printf %s "$c"
		else
			# (Some versions of bash, e.g. macOS's /bin/bash 3.2, treat bytes >= 0x80
			# as negative here, so mask to a single byte.)
			printf -v n %d "'$c"
			printf %%%02X $((n & 255))
		fi
	done
}
urlencode() {
	printf '%s' "$1" | urlencode_help
}
urldecode() {
	# Escape existing backslashes, then turn each %XX into \xXX for printf %b.
	local s=${1//\\/\\\\}
	printf '%b' "${s//%/\\x}"
}

can_delete_file() {
	# File must exist.
	# (If it's a broken symlink, -e will return false, but -L will return true.)
	if [ ! -e "$1" ] && [ ! -L "$1" ]; then
		echo "zap: File '$1' does not exist" >&2
		return 1
	fi
	# If we're the superuser, we can always delete.
	if [ "$EUID" -eq 0 ]; then
		return 0
	fi
	# To delete a file, all you need is write and execute permissions on its parent directory.
	local dir
	dir=$(mydirname "$1") || return 1
	if [ ! -w "$dir" ] || [ ! -x "$dir" ]; then
		echo "Cannot zap '$1' because we don't have write and execute permissions on its parent directory '$dir'" >&2
		return 1
	fi
}

is_writable_by_current_user() {
	# If we're the superuser, permissions don't matter.
	if [ "$EUID" -eq 0 ]; then
		return 0
	fi
	# Permissions for a symlink don't matter (except on Mac, but only when following the symlink; deleting it is always fine).
	if [ -L "$1" ]; then
		return 0
	fi
	# Check if writable.
	if [ ! -w "$1" ]; then
		echo "zap: The file '$1' is not writable by the current user. Use --force to override." >&2
		return 1
	fi
}

# https://unix.stackexchange.com/a/44267
# https://pubs.opengroup.org/onlinepubs/7908799/xcu/df.html
is_same_filesystem() {
	df -P "$(get_abs_filename "$1")" "$(get_abs_filename "$2")" | awk 'NR==2 {dev1=$1} NR==3 {exit($1!=dev1)}'
}

can_read_file() {
	# If we're the superuser, we can always read.
	if [ "$EUID" -eq 0 ]; then
		return 0
	fi
	# Check if readable.
	[ -r "$1" ]
}

can_move_to() {
	local destdir
	destdir="$1"
	shift

	local file path
	for file in "$@"; do
		# If the file and destination directory aren't on the same filesystem, then
		# mv will need to copy instead of rename. In order to copy, we need to read
		# everything, and in order to remove the original afterwards, we need to be
		# able to modify every directory.
		# (Symlinks are moved as-is, so their targets don't need to be readable.)
		if [ -L "$file" ] || is_same_filesystem "$file" "$destdir"; then
			continue
		fi
		while IFS= read -r -d '' path; do
			[ ! -L "$path" ] || continue
			if ! can_read_file "$path"; then
				echo "zap: Can't trash '$file': it has to be copied to '$destdir' on another filesystem, but '$path' isn't readable" >&2
				return 1
			fi
			if [ -d "$path" ] && { [ ! -w "$path" ] || [ ! -x "$path" ]; }; then
				echo "zap: Can't trash '$file': it has to be copied to '$destdir' on another filesystem, but the directory '$path' isn't writable, so the original couldn't be removed afterwards" >&2
				return 1
			fi
		done < <(find "$file" -print0 2>/dev/null)
	done
}

### freedesktop helpers

# detect stat flavor
stattype=""
if command -v stat >/dev/null 2>&1; then
	if stat -c %d / >/dev/null 2>&1; then
		stattype=gnu
	elif stat -f %d / >/dev/null 2>&1; then
		stattype=bsd
	fi
fi
stat_device() {
	if [ "$stattype" = gnu ]; then
		stat -c %d "$1"
	elif [ "$stattype" = bsd ]; then
		stat -f %d "$1"
	else
		return 2
	fi
}
stat_inode() {
	if [ "$stattype" = gnu ]; then
		stat -c %i "$1"
	elif [ "$stattype" = bsd ]; then
		stat -f %i "$1"
	else
		return 2
	fi
}
stat_size() {
	if [ "$stattype" = gnu ]; then
		stat -c %s "$1"
	elif [ "$stattype" = bsd ]; then
		stat -f %z "$1"
	else
		return 2
	fi
}
stat_mtime() {
	if [ "$stattype" = gnu ]; then
		stat -c %Y "$1"
	elif [ "$stattype" = bsd ]; then
		stat -f %m "$1"
	else
		return 2
	fi
}

# mountpoint_of FILE
# prints the mountpoint containing FILE (resolves symlinks).
# FILE should be an absolute path.
mountpoint_of() {
	local path
	# canonicalize (FILE might not be a directory, so use its parent)
	path=$(cd "$(mydirname "$1")" 2>/dev/null && pwd -P) || return 2

	mountpoint_of___helper "$path" ||
		# fallback: use df (POSIX df -P if available). Prints mountpoint column from df.
		list_mountpoints "$path" | head -n 1
}
mountpoint_of___helper() {
	local dev parent parentdev
	dev=$(stat_device "$1") || return 2

	while [ "$1" != "/" ]; do
		parent=$(mydirname "$1") || return 2
		parentdev=$(stat_device "$parent") || return 2
		if [ "$parentdev" = "$dev" ]; then
			set -- "$parent"
		else
			printf '%s\n' "$1"
			return 0
		fi
	done

	# reached root
	printf '%s\n' /
}

home_mountpoint=
get_top_freedesktop_trashdir() {
	local topdir

	if [ -z "$home_mountpoint" ]; then
		home_mountpoint=$(mountpoint_of "${XDG_DATA_HOME:-$HOME/.local/share}") || return 1
	fi
	topdir="$(mountpoint_of "$1")" || return 1

	# When trashing a file from a non-home partition/device [4], ...
	# [4] To be more precise, from a partition/device different from the one on which $XDG_DATA_HOME resides.
	if [ "$topdir" != "$home_mountpoint" ]; then
		# ... an implementation (if it supports trashing in top directories) MUST check for
		# the presence of $topdir/.Trash.
		if
			[ -d "$topdir/.Trash" ] &&
				# If this directory is present, the implementation MUST, by default,
				# check for the “sticky bit”.
				[ -k "$topdir/.Trash" ] &&
				# The implementation also MUST check that this directory is not a
				# symbolic link.
				[ ! -L "$topdir/.Trash" ] &&
				# If the directory exists and passes the checks, a subdirectory of the
				# $topdir/.Trash directory is to be used as the user’s trash directory for
				# this partition/device. The name of this subdirectory is the numeric
				# identifier of the current user ($topdir/.Trash/$uid). When trashing a
				# file, if this directory does not exist for the current user, the
				# implementation MUST immediately create it, without any warnings or
				# delays for the user.
				{ [ -n "$dry_run" ] || mkdir -p "$topdir/.Trash/$UID"/{files,info} >/dev/null 2>&1; }
		then
			printf '%s\n' "$topdir/.Trash/$UID"
			return
		fi

		# (2) If an $topdir/.Trash directory is absent, an $topdir/.Trash-$UID
		# directory is to be used as the user’s trash directory for this
		# device/partition. $UID is the user’s numeric identifier.
		if [ -n "$dry_run" ] || mkdir -p "$topdir/.Trash-$UID"/{files,info} >/dev/null 2>&1
		then
			printf '%s\n' "$topdir/.Trash-$UID"
			return
		fi

		# We couldn't use a trash directory on the file's own filesystem.
		return 3
	fi

	return 4
}

get_freedesktop_trashdir() {
	local ret
	ret=$(get_top_freedesktop_trashdir "$1") || {
		if [ $? -eq 3 ]; then
			echo "zap: Warning: can't use a trash directory on the same filesystem as '$1'; it will be copied to the home trash instead" >&2
		fi
		ret="${XDG_DATA_HOME:-$HOME/.local/share}/Trash"
	}

	[ -z "$verbose" ] || echo mkdir -p "'$ret"/{files,info}"'" '>&2' >&2
	[ -n "$dry_run" ] || mkdir -p "$ret"/{files,info} >&2
	# If chflags is available (BSD/macOS), make sure trash is hidden. This should
	# hopefuly make it hidden on Windows on shared network SMB drives.
	if command -v chflags >/dev/null 2>&1; then
		[ -z "$verbose" ] || echo chflags hidden "'$ret'" '>/dev/null' '2>&1' >&2
		[ -n "$dry_run" ] || chflags hidden "$ret" >/dev/null 2>&1 || :
	fi

	printf '%s\n' "$ret"
}

# write_trashinfo TRASHDIR BASENAME DATE CONTENTS
# Writes CONTENTS to TRASHDIR/info/NAME.trashinfo, where NAME is BASENAME
# (possibly with DATE and random numbers appended) such that neither
# TRASHDIR/info/NAME.trashinfo nor TRASHDIR/files/NAME already exists. Never
# overwrites anything. Prints NAME.
write_trashinfo() (
	# (Subshell, so that noclobber doesn't leak out.)
	local trashdir="$1" base="$2" thedate="$3" contents="$4" name
	set -o noclobber # don't overwrite file when using >
	name=$base
	if [ -e "$trashdir/info/$name.trashinfo" ] || [ -L "$trashdir/info/$name.trashinfo" ] || [ -e "$trashdir/files/$name" ] || [ -L "$trashdir/files/$name" ]; then
		name="$base $thedate"
	fi
	while [ -e "$trashdir/info/$name.trashinfo" ] || [ -L "$trashdir/info/$name.trashinfo" ] || [ -e "$trashdir/files/$name" ] || [ -L "$trashdir/files/$name" ]; do
		name="$base $thedate $RANDOM"
	done
	while : ; do
		[ -z "$verbose" ] || printf 'Writing to "%s":\n%s\n' "$trashdir/info/$name.trashinfo" "$(printf '%s\n' "$contents" | sed 's/^/\t/')" >&2
		if [ -n "$dry_run" ] || printf '%s\n' "$contents" >"$trashdir/info/$name.trashinfo"; then
			break
		else
			[ -z "$verbose" ] || printf 'Failed to write! Trying a different name. ' >&2
			name="$base $thedate $RANDOM$RANDOM"
		fi
	done
	printf '%s\n' "$name"
)

list_mountpoints() {
	df -P "$@" | {
		IFS= read -r _header_line
		local regex='^.* +[0-9]+ +[0-9]+ +[0-9]+ +[0-9]+%? +(/.*)$'
		local ret=0 line
		while IFS= read -r line; do
			if [[ $line =~ $regex ]]; then
				mountpoint=${BASH_REMATCH[1]}
				printf '%s\n' "$mountpoint"
			else
				printf "Can't parse df -P output line: '%s'\n" "$line" >&2
				ret=1
			fi
		done
		return $ret
	}
}

get_freedesktop_trashdirs() {
	local home_trashdir="${XDG_DATA_HOME:-$HOME/.local/share}/Trash"
	if [[ -d $home_trashdir ]]; then
		printf '%s\n' "$home_trashdir"
	fi

	local mountpoint
	list_mountpoints | while IFS= read -r mountpoint; do
		ls -d "$mountpoint/.Trash/$UID" "$mountpoint/.Trash-$UID" 2>/dev/null || :
	done
}

# read_trashinfo TRASHDIR INFOFILE
# Sets $trashinfo_path (absolute, decoded) and $trashinfo_date, plus the
# $trashinfo_zap_* variables from zap's own X-Zap-* keys (empty if absent).
read_trashinfo() {
	local trashdir="$1" line in_section=
	trashinfo_path=
	trashinfo_date=
	trashinfo_zap_trashed_path=
	trashinfo_zap_device=
	trashinfo_zap_inode=
	trashinfo_zap_mtime=
	trashinfo_zap_size=
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
			('[Trash Info]') in_section=1 ;;
			('['*) in_section= ;;
			(Path=*) [ -z "$in_section" ] || trashinfo_path=$(urldecode "${line#Path=}") ;;
			(DeletionDate=*) [ -z "$in_section" ] || trashinfo_date=${line#DeletionDate=} ;;
			(X-Zap-TrashedPath=*) [ -z "$in_section" ] || trashinfo_zap_trashed_path=$(urldecode "${line#*=}") ;;
			(X-Zap-Device=*) [ -z "$in_section" ] || trashinfo_zap_device=${line#*=} ;;
			(X-Zap-Inode=*) [ -z "$in_section" ] || trashinfo_zap_inode=${line#*=} ;;
			(X-Zap-Mtime=*) [ -z "$in_section" ] || trashinfo_zap_mtime=${line#*=} ;;
			(X-Zap-Size=*) [ -z "$in_section" ] || trashinfo_zap_size=${line#*=} ;;
		esac
	done <"$2"
	[ -n "$trashinfo_path" ] || return 1
	# Paths in top-directory trashes may be relative to the top directory.
	if [[ $trashinfo_path != /* ]]; then
		case "$trashdir" in
			(*/.Trash/"$UID") trashinfo_path="${trashdir%/.Trash/"$UID"}/$trashinfo_path" ;;
			(*/.Trash-"$UID") trashinfo_path="${trashdir%/.Trash-"$UID"}/$trashinfo_path" ;;
			(*) return 1 ;;
		esac
	fi
}

# Where zap keeps its own .trashinfo records, for files trashed with strategies
# that don't write any themselves (e.g. on macOS).
zap_recorddir="${XDG_DATA_HOME:-$HOME/.local/share}/zap"

# Sets $identity_device, $identity_inode, $identity_mtime and $identity_size
# for FILE (without following symlinks).
file_identity() {
	identity_device=$(stat_device "$1") &&
		identity_inode=$(stat_inode "$1") &&
		identity_mtime=$(stat_mtime "$1") &&
		identity_size=$(stat_size "$1")
}

# Whether FILE is the file described by the $trashinfo_zap_* variables.
# (Moving a directory can change its mtime and size, so only the device and
# inode are compared for directories.)
identity_matches() {
	{ [ -e "$1" ] || [ -L "$1" ]; } && file_identity "$1" || return 1
	[ "$identity_device" = "$trashinfo_zap_device" ] && [ "$identity_inode" = "$trashinfo_zap_inode" ] || return 1
	[ -d "$1" ] && [ ! -L "$1" ] && return 0
	[ "$identity_mtime" = "$trashinfo_zap_mtime" ] && [ "$identity_size" = "$trashinfo_zap_size" ]
}

# Prints the path of the item at the top level of one of the misc trash
# directories matching the $trashinfo_zap_* variables.
find_zap_trashed_file() {
	local dir f
	while IFS= read -r dir; do
		for f in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
			if identity_matches "$f"; then
				printf '%s\n' "$f"
				return
			fi
		done
	done < <(get_misc_trashdirs)
	return 1
}

# each_trash_entry CALLBACK
# Calls CALLBACK once for every trashed item that can be found, whether in a
# freedesktop.org trash directory or recorded by zap, with these set:
#   $entry_date      deletion date
#   $entry_path      original path
#   $entry_location  where the item currently is in the trash
#   $entry_info      its .trashinfo file
each_trash_entry() {
	local trashdir info name
	while IFS= read -r trashdir; do
		for info in "$trashdir"/info/*.trashinfo; do
			[ -f "$info" ] || continue
			read_trashinfo "$trashdir" "$info" || continue
			name=$(mybasename "$info")
			entry_location="$trashdir/files/${name%.trashinfo}"
			[ -e "$entry_location" ] || [ -L "$entry_location" ] || continue
			entry_date=$trashinfo_date
			entry_path=$trashinfo_path
			entry_info=$info
			"$1"
		done
	done < <(get_freedesktop_trashdirs)

	for info in "$zap_recorddir"/info/*.trashinfo; do
		[ -f "$info" ] || continue
		read_trashinfo "$zap_recorddir" "$info" || continue
		if [ -n "$trashinfo_zap_trashed_path" ] && identity_matches "$trashinfo_zap_trashed_path"; then
			entry_location=$trashinfo_zap_trashed_path
		elif entry_location=$(find_zap_trashed_file); then
			:
		else
			[ -z "$verbose" ] || echo "zap: Skipping stale record '$info': '$trashinfo_path' is no longer in the trash" >&2
			continue
		fi
		entry_date=$trashinfo_date
		entry_path=$trashinfo_path
		entry_info=$info
		"$1"
	done
}

# remember_identities FILE...
# Saves the identity of each FILE, for record_trashed to use after trashing.
remember_identities() {
	remembered_devices=() remembered_inodes=() remembered_mtimes=() remembered_sizes=()
	local f
	for f in "$@"; do
		if file_identity "$f"; then
			remembered_devices+=("$identity_device")
			remembered_inodes+=("$identity_inode")
			remembered_mtimes+=("$identity_mtime")
			remembered_sizes+=("$identity_size")
		else
			remembered_devices+=('') remembered_inodes+=('') remembered_mtimes+=('') remembered_sizes+=('')
		fi
	done
}

# record_trashed FILE...
# For each FILE (the same list passed to remember_identities) that's no longer
# at its original path, find it in the trash by its remembered identity and
# write a record to $zap_recorddir/info so that --list and --restore can find it.
record_trashed() {
	local i=0 f trashed
	for f in "$@"; do
		if [ -n "${remembered_inodes[$i]}" ] && [ ! -e "$f" ] && [ ! -L "$f" ]; then
			trashinfo_zap_device=${remembered_devices[$i]}
			trashinfo_zap_inode=${remembered_inodes[$i]}
			trashinfo_zap_mtime=${remembered_mtimes[$i]}
			trashinfo_zap_size=${remembered_sizes[$i]}
			if trashed=$(find_zap_trashed_file); then
				write_zap_record "$f" "$trashed"
			else
				echo "zap: Warning: couldn't find '$f' in the trash, so it won't be restorable with --restore" >&2
				warn_full_disk_access
			fi
		fi
		i=$((i + 1))
	done
}

# write_zap_record ORIGINALPATH TRASHEDPATH
# Writes a record for an item that has been moved from ORIGINALPATH to TRASHEDPATH.
write_zap_record() {
	local thedate
	if ! file_identity "$2"; then
		echo "zap: Warning: couldn't stat '$2', so '$1' won't be restorable with --restore" >&2
		return 1
	fi
	thedate=$(date +"%Y-%m-%dT%H:%M:%S")
	if ! {
		mkdir -p "$zap_recorddir/info" &&
		write_trashinfo "$zap_recorddir" "$(mybasename "$1")" "$thedate" "$(
			printf '[Trash Info]\nPath=%s\nDeletionDate=%s\n' "$(urlencode "$1")" "$thedate"
			printf 'X-Zap-Strategy=%s\nX-Zap-TrashedPath=%s\n' "$ZAP_STRATEGY" "$(urlencode "$2")"
			printf 'X-Zap-Device=%s\nX-Zap-Inode=%s\nX-Zap-Mtime=%s\nX-Zap-Size=%s' \
				"$identity_device" "$identity_inode" "$identity_mtime" "$identity_size"
		)" >/dev/null
	}; then
		echo "zap: Warning: couldn't write a record for '$1' in '$zap_recorddir/info', so it won't be restorable with --restore" >&2
		return 1
	fi
}

# On macOS, reading ~/.Trash requires Full Disk Access.
warn_full_disk_access() {
	if [ "$(uname -s)" = Darwin ] && [ -d "$HOME/.Trash" ] && ! ls "$HOME/.Trash" >/dev/null 2>&1; then
		echo "zap: Hint: your terminal may need Full Disk Access (System Settings > Privacy & Security) to read '$HOME/.Trash'" >&2
	fi
}

# Prints DELETIONDATE<TAB>ORIGINALPATH for every trashed item, oldest first.
list_trash() {
	# shellcheck disable=SC2329 # called by each_trash_entry
	print_entry() {
		printf '%s\t%s\n' "$entry_date" "$entry_path"
	}
	each_trash_entry print_entry | LC_ALL=C sort -s -t "$(printf '\t')" -k1,1
}

get_misc_trashdirs() {
	local dir
	{
		for dir in "$HOME"/{.Trash,.trash,trash,Trash,.gomi} /Volumes/*/.Trashes/*; do
			[ ! -d "$dir" ] || printf '%s\n' "$dir"
		done

		local mountpoint
		list_mountpoints | while IFS= read -r mountpoint; do
			for dir in "$mountpoint"/.Trashes/*; do
				[ ! -d "$dir" ] || printf '%s\n' "$dir"
			done
		done
	} | {
		# Skip duplicates by device and inode rather than by path, since e.g. on
		# a case-insensitive filesystem, ~/.Trash and ~/.trash are the same
		# directory (and pwd -P keeps whichever spelling it was given).
		local seen=' ' id
		while IFS= read -r dir; do
			dir=$(cd "$dir" 2>/dev/null && pwd -P) || continue
			id="$(stat_device "$dir"):$(stat_inode "$dir")" || continue
			case "$seen" in
				(*" $id "*) ;;
				(*)
					seen="$seen$id "
					printf '%s\n' "$dir"
					;;
			esac
		done
	}
}

## Parse options
action=put
failed=
force=
dry_run=
verbose=
# verbose by default if sudo
[ "$EUID" -ne 0 ] || verbose=1
# TODO: implement interactive
# 0 (-f OR --interactive=never): never prompt
# 1 (default): prompt if write-protected and standard output is a terminal
# 2 (-I): prompt once
# 3 (-i): prompt always
interactive=1
# TODO: maybe add --sudo option (or maybe prompt in that case if interactive>=1)
# that uses sudo to change the ownership before trashing if we don't have the
# permissions, since:
# 1. sudo changes $HOME to /root and unsets $XDG_DATA_HOME on Linux, and
# 2. we probably don't want unmovable stuff in our user trash
# shellcheck disable=SC2034 # $interactive isn't used until -i/-I are implemented
while [[ $# -gt 0 ]]; do
	opt="$1"
	case "$1" in
		(-h|--help)
			print_usage
			exit
			;;
		(-f|--force)
			force=1
			interactive=0
			shift
			;;
		(-n|--dry-run)
			dry_run=1
			verbose=1
			shift
			;;
		(-d|--dir|-r|-R|--recursive) #no-op, for rm compatibility
			shift
			;;
		(-l|--list)
			action=list
			shift
			;;
		(--restore)
			action=restore
			shift
			;;
		(-v|--verbose)
			verbose=1
			shift
			;;
		(--interactive=never|--interactive=no|--interactive=none)
			interactive=0
			shift
			echo "TODO: implement -i/-I/--interactive"; exit 5
			;;
		(-I|--interactive=once)
			interactive=2
			shift
			echo "TODO: implement -i/-I/--interactive"; exit 5
			;;
		(-i|--interactive|--interactive=always|--interactive=yes)
			interactive=3
			shift
			echo "TODO: implement -i/-I/--interactive"; exit 5
			;;
		(--interactive=*)
			# message from GNU rm
			echo >&2 "zap: ambiguous argument ‘$1’
Valid arguments for ‘--interactive’ are:
  - ‘never’, ‘no’, ‘none’
  - ‘once’
  - ‘always’, ‘yes’
Try '$0 --help' for more information."
			exit 5
			;;
		(--strategy|-s)
			if [[ $# -lt 2 ]]; then
				echo "zap: option '$1' requires an argument" >&2
				exit 2
			fi
			ZAP_STRATEGY="$2"
			shift
			shift
			;;
		(--strategy=*)
			arg=${1#--strategy=}
			shift
			set -- --strategy "$arg" "$@"
			;;
		(-s?*) # -sSTRATEGY
			arg=${1#-s}
			shift
			set -- --strategy "$arg" "$@"
			;;
		(--version) # necessary for man2help
			echo "zap.sh 0.0.16"
			exit
			;;
		(--)
			shift
			break
			;;
		(-[^-][^-]*) # expand multiple single-char options (e.g. -rf)
			shift
			other="${opt#-?}"
			set -- "${opt%"$other"}" "-${other}" "$@"
			;;
		(-*)
			echo "ERROR: Unknown option: $1" >&2
			print_usage
			exit 2
			;;
		(*)
			break
			;;
	esac
done

if [[ $# -eq 0 ]] && [ -z $force ] && [ "$action" = put ]; then
	print_usage
	exit 2
fi

## List / restore

# These look in every trash location zap knows about, regardless of strategy.
if [ "$action" = list ] || [ "$action" = restore ]; then
	warn_full_disk_access
fi

if [ "$action" = list ]; then
	if [[ $# -gt 0 ]]; then
		echo "zap: --list doesn't take any arguments" >&2
		exit 2
	fi
	list_trash
	exit
fi

# is_in_array STRING ELEMENT...
is_in_array() {
	local needle="$1" x
	shift
	for x in "$@"; do
		[ "$x" != "$needle" ] || return 0
	done
	return 1
}

# find_restore_candidate FILE
# Finds the most recently trashed item whose original path is FILE, and checks
# that it can be moved back. Sets $restore_target, $restore_location and
# $restore_info, or prints a message and fails.
find_restore_candidate() {
	local best_info='' best_location='' best_date='' parent
	restore_location=
	if [[ $1 == *$'\n' ]]; then
		echo "zap: Can't restore '$1': file names ending in a newline aren't supported" >&2
		return 1
	fi
	restore_target=$(get_abs_filename "$1") || return 1
	# shellcheck disable=SC2329 # called by each_trash_entry
	consider_entry() {
		if [ "$entry_path" = "$restore_target" ] && ! [[ $entry_date < $best_date ]]; then
			best_info=$entry_info
			best_location=$entry_location
			best_date=$entry_date
		fi
	}
	each_trash_entry consider_entry

	if [ -z "$best_info" ]; then
		echo "zap: '$restore_target' was not found in the trash" >&2
		return 1
	fi
	if [ -e "$restore_target" ] || [ -L "$restore_target" ]; then
		echo "zap: Can't restore '$restore_target': it already exists" >&2
		return 1
	fi
	parent=$(mydirname "$restore_target") || return 1
	if [ "$EUID" -ne 0 ] && { [ ! -w "$parent" ] || [ ! -x "$parent" ]; }; then
		echo "zap: Can't restore '$restore_target': we don't have write and execute permissions on '$parent'" >&2
		return 1
	fi
	if [ -d "$best_location" ] && [ ! -L "$best_location" ] && [ "$EUID" -ne 0 ] && [ ! -w "$best_location" ]; then
		echo "zap: Can't restore '$restore_target': moving a directory requires write permission on it ('$best_location')" >&2
		return 1
	fi
	can_move_to "$parent" "$best_location" || return 1
	restore_location=$best_location
	restore_info=$best_info
}

if [ "$action" = restore ]; then
	if [[ $# -eq 0 ]]; then
		echo "zap: --restore requires at least one FILE" >&2
		exit 2
	fi
	# Check every argument before restoring anything.
	targets=() locations=() infos=()
	for file in "$@"; do
		if find_restore_candidate "$file" && is_in_array "$restore_target" "${targets[@]+"${targets[@]}"}"; then
			echo "zap: '$restore_target' was given more than once" >&2
		elif [ -n "$restore_location" ]; then
			targets+=("$restore_target")
			locations+=("$restore_location")
			infos+=("$restore_info")
			continue
		fi
		[ -n "$force" ] || exit 1
		failed=1
	done
	i=0
	while [ "$i" -lt "${#targets[@]}" ]; do
		[ -z "$verbose" ] || echo mv -i "'${locations[$i]}'" "'${targets[$i]}'" '</dev/null' >&2
		if [ -z "$dry_run" ]; then
			if mv -i "${locations[$i]}" "${targets[$i]}" </dev/null; then
				command rm -f -- "${infos[$i]}"
			else
				echo "zap: Failed to restore '${targets[$i]}'" >&2
				[ -n "$force" ] || exit 1
				failed=1
				i=$((i + 1))
				continue
			fi
		fi
		printf '%s\n' "${targets[$i]}"
		i=$((i + 1))
	done
	[ -z "$failed" ] || exit 1
	exit
fi

## Choose strategy

choose_strategy() {
	UNAME=$(command -v uname) || exit 2 # https://gist.github.com/prabirshrestha/3080525?permalink_comment_id=2962265#gistcomment-2962265
	case $("${UNAME}" | tr '[:upper:]' '[:lower:]') in
		(msys*|cygwin*|mingw*|nt|win*)
			echo "Windows isn't currently supported!" >&2
			return 1
	esac

	if [ "$(uname -s)" = "Darwin" ]; then
		if [ -x /usr/bin/trash ]; then
			# introduced in macOS 14.0
			echo macos_trash_command
			return
		elif command -v osascript >/dev/null 2>&1; then
			echo macos_applescript
			return
		fi
	fi

	echo freedesktop
	return
}

ZAP_STRATEGY=${ZAP_STRATEGY:-$(choose_strategy)}
[ -n "$verbose" ] && echo "Using strategy: $ZAP_STRATEGY" >&2

## Checks

# trash_dir_for FILE
# Prints the trash directory FILE will be moved into with the current strategy,
# or nothing if zap doesn't control that (e.g. gio, trash_cli).
trash_dir_for() {
	case "$ZAP_STRATEGY" in
		(freedesktop) get_freedesktop_trashdir "$1" ;;
		(macos_mv|macos_trash_command|macos_applescript) printf '%s\n' "$HOME/.Trash" ;;
	esac
}

# Fails if FILE is inside, or contains, the trash directory TRASH.
check_not_trash_sub_or_super_directory() {
	local trash_realpath file_realpath
	[ ! -L "$1" ] || return 0
	command -v realpath >/dev/null 2>&1 || return 0
	# (During a dry run, the trash directory might not exist yet.)
	trash_realpath=$(realpath "$2" 2>/dev/null) || return 0
	file_realpath=$(realpath "$1") || return 1
	if [[ "$file_realpath"/ == "$trash_realpath"/* ]]; then
		echo "zap: Can't trash '$file_realpath': it's inside the trash directory '$trash_realpath'" >&2
		return 1
	elif [[ "$trash_realpath"/ == "$file_realpath"/* ]]; then
		echo "zap: Can't trash '$file_realpath': it contains the trash directory '$trash_realpath'" >&2
		return 1
	fi
}

# preflight_check FILE TRASH
# Checks that FILE (an absolute path) can be moved into the trash directory
# TRASH (which may be empty if unknown). Prints a message and fails if not.
preflight_check() {
	# Moving a directory to a different parent directory requires write
	# permission on the directory itself (to update its ".." entry), so --force
	# can't override that. (This is the behaviour on Linux; it's presumably the
	# same on macOS and the BSDs, but I haven't verified that.)
	if [ -d "$1" ] && [ ! -L "$1" ] && [ "$EUID" -ne 0 ] && [ ! -w "$1" ]; then
		case "$ZAP_STRATEGY" in
			(dangerous_*) ;;
			(*)
				echo "zap: Can't trash '$1': moving a directory requires write permission on it" >&2
				return 1
				;;
		esac
	fi
	[ -n "$2" ] || return 0
	check_not_trash_sub_or_super_directory "$1" "$2" || return 1
	if [ -d "$2" ] && ! can_move_to "$2" "$1"; then
		return 1
	fi
}

# Check every argument before trashing anything.
files=()
trashdirs=()
for file in "$@"; do
	if [ ! -e "$file" ] && [ ! -L "$file" ] && [ -n "$force" ]; then
		# Like rm -f, silently ignore nonexistent files.
		continue
	elif [[ $file == *$'\n' ]]; then
		echo "zap: Can't trash '$file': file names ending in a newline aren't supported" >&2
		[ -n "$force" ] || exit 1
		failed=1
	elif ! can_delete_file "$file"; then
		[ -n "$force" ] || exit 1
		failed=1
	elif [ -z "$force" ] && ! is_writable_by_current_user "$file"; then
		exit 1
	else
		file=$(get_abs_filename "$file")
		trash=$(trash_dir_for "$file")
		if ! preflight_check "$file" "$trash"; then
			[ -n "$force" ] || exit 1
			failed=1
			continue
		fi
		[ -z "$verbose" ] || echo "Will zap $file"
		files+=("$file")
		trashdirs+=("$trash")
	fi
done
set -- ${files[@]+"${files[@]}"}

for file in "$@"; do
	echo "$file"
done

if [[ $# -eq 0 ]]; then
	if [ -n "$force" ]; then
		[ -z "$failed" ] || exit 1
		exit
	else
		echo "Nothing to delete"
		exit 1
	fi
fi

## Execute

# check that none of the arguments are sub/superdirectories of the trash directory

if [ -n "$force" ]; then
	set +euo pipefail
fi

case "$ZAP_STRATEGY" in
	(freedesktop)
		# https://specifications.freedesktop.org/trash-spec/latest/
		i=0
		for file in "$@"; do
			trash=${trashdirs[$i]}
			i=$((i + 1))
			thedate=$(date +"%Y-%m-%dT%H:%M:%S")
			dest_filename=$(write_trashinfo "$trash" "$(mybasename "$file")" "$thedate" \
				"$(printf '[Trash Info]\nPath=%s\nDeletionDate=%s' "$(urlencode "$file")" "$thedate")")
			[ -z "$verbose" ] || echo mv -i "'$file'" "'$trash/files/$dest_filename'" '</dev/null' >&2
			if [ -z "$dry_run" ] && ! mv -i "$file" "$trash/files/$dest_filename" </dev/null; then
				command rm -f -- "$trash/info/$dest_filename.trashinfo"
				echo "zap: Failed to move '$file' to the trash" >&2
				[ -n "$force" ] || exit 1
				failed=1
			fi
		done
		;;

	macos_applescript)
		# Strategy: use AppleScript like the following to delete files/directories.
		#   tell application "Finder" to delete every item of {(POSIX file "/path/one"), (POSIX file "/path/two")}
		# (https://github.com/ali-rantakari/trash/blob/d33f12fb91d2ccb553098e0f0aea57a2add77e09/trash.m#L284C10-L285C64)
		applescript_list=
		for file in "$@"; do
			# get full path, then replace \ with \\, then replace " with \"
			# (in case there are any backslashes or double quotes in the file name itself,
			# we're escaping for the AppleScript string - https://www.oreilly.com/library/view/applescript-the-definitive/0596102119/ch13s07.html )
			fullpath=$(get_abs_filename "$file" | sed 's/\\/\\\\/g' | sed 's/\"/\\\"/g')
			applescript_list="$applescript_list(POSIX file \"$fullpath\"), "
		done
		# remove trailing comma and space
		applescript_list="${applescript_list%, }"
		command="tell app \"Finder\" to delete every item of {$applescript_list}"
		[ -z "$verbose" ] || echo "$command" >&2
		if [ -z "$dry_run" ]; then
			remember_identities "$@"
			status=0
			osascript -e "$command" >/dev/null || status=$?
			record_trashed "$@"
			[ "$status" -eq 0 ] || exit "$status"
		fi
		;;

	macos_mv)
		trash="$HOME/.Trash"
		if ! [ -d "$trash" ]; then
			echo "trash: $trash does not exist" >&2
			exit 1
		fi
		[ -z "$verbose" ] || echo "Trash directory: '$trash'" >&2
		for file in "$@"; do
			dest_filename=$(mybasename "$file")
			while [ -e "$trash/$dest_filename" ] || [ -L "$trash/$dest_filename" ]; do
				dest_filename="$dest_filename $(date +"%Y-%m-%dT%H:%M:%S")"
			done
			[ -z "$verbose" ] || echo mv -i "'$file'" "'$trash/$dest_filename'" '</dev/null' >&2
			if [ -z "$dry_run" ]; then
				if mv -i "$file" "$trash/$dest_filename" </dev/null; then
					write_zap_record "$file" "$trash/$dest_filename" || :
				else
					echo "zap: Failed to move '$file' to the trash" >&2
					[ -n "$force" ] || exit 1
					failed=1
				fi
			fi
		done
		;;

	macos_trash_command)
		# introduced in macOS 14.0
		options=()
		[ -n "$force"   ] || options+=(--stopOnError)
		[ -z "$verbose" ] || options+=(--verbose)
		[ -z "$verbose" ] || echo /usr/bin/trash ${options[@]+"${options[@]}"} "$@" >&2
		# /usr/bin/trash doesn't support `--`, but that should be fine because we're
		# using absolute paths.
		if [ -z "$dry_run" ]; then
			remember_identities "$@"
			status=0
			/usr/bin/trash ${options[@]+"${options[@]}"} "$@" || status=$?
			record_trashed "$@"
			[ "$status" -eq 0 ] || exit "$status"
		fi
		;;

	gio)
		# NOTE: This errors sometimes:
		#   gio: file:///tmp/a: Trashing on system internal mounts is not supported
		#
		# The freedesktop.org spec (https://specifications.freedesktop.org/trash-spec/latest/#trash-directories )
		# does *allow* implementations to error in this situation, though it also allows
		# implementations to just put everything in the "home trash" directory, which is
		# what we do in the freedesktop strategy.
		# https://www.inmotionhosting.com/support/server/linux/send-files-to-trash-with-gio-trash/
		options=()
		[ -z "$force"   ] || options+=(--force)
		[ -z "$verbose" ] || echo gio trash ${options[@]+"${options[@]}"} -- "$@" >&2
		[ -n "$dry_run" ] || gio trash ${options[@]+"${options[@]}"} -- "$@"
		;;

	kioclient)
		pre_options=(--noninteractive --platform offscreen)
		options=()
		[ -z "$verbose" ] || echo kioclient ${pre_options[@]+"${pre_options[@]}"} move ${options[@]+"${options[@]}"} -- "$@" trash:/ >&2
		[ -n "$dry_run" ] || kioclient ${pre_options[@]+"${pre_options[@]}"} move ${options[@]+"${options[@]}"} -- "$@" trash:/
		;;

	trash_cli)
		# https://github.com/andreafrancia/trash-cli
		options=()
		[ -z "$force"   ] || options+=(--force)
		[ -z "$verbose" ] || options+=(--verbose)
		[ -z "$verbose" ] || echo trash-put ${options[@]+"${options[@]}"} -- "$@" >&2
		[ -n "$dry_run" ] || trash-put ${options[@]+"${options[@]}"} -- "$@"
		;;

	dangerous_rm)
		# https://pubs.opengroup.org/onlinepubs/9699919799/utilities/rm.html
		options=(-f)
		# [ -z "$force"   ] || options+=(-f)
		[ -z "$verbose" ] || echo rm ${options[@]+"${options[@]}"} "$@" >&2
		# POSIX rm doesn't support `--` (though GNU and BSD rm both do), but that
		# should be fine because we're using absolute paths.
		[ -n "$dry_run" ] || rm ${options[@]+"${options[@]}"} "$@"
		;;

	dangerous_shred)
		# https://www.gnu.org/software/coreutils/manual/html_node/shred-invocation.html
		options=(--remove --zero --force)
		# [ -z "$force"   ] || options+=(--force)
		[ -z "$verbose" ] || options+=(--verbose)
		[ -z "$verbose" ] || echo shred ${options[@]+"${options[@]}"} -- "$@" >&2
		[ -n "$dry_run" ] || shred ${options[@]+"${options[@]}"} -- "$@"
		;;

	*)
		echo "Unrecognized strategy: $ZAP_STRATEGY" >&2
		exit 1
		;;
esac

[ -z "$failed" ] || exit 1

